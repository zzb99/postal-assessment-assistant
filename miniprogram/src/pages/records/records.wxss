.record { padding: 24rpx 28rpx; }
.record-hover { opacity: 0.85; }
.record-top { display: flex; align-items: center; justify-content: space-between; }
.record-no { font-weight: 600; font-size: 30rpx; color: var(--green); }
.record-unit { display: flex; justify-content: space-between; margin-top: 8rpx; font-size: 30rpx; }
.record-amount { font-weight: 600; }
.status { font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 999rpx; }
.status-effective { background: var(--green-soft); color: var(--green); }
.status-voided { background: #f3e8e7; color: var(--danger); }
.status-draft { background: #f1f3f2; color: var(--muted); }
.end { text-align: center; margin: 8rpx 0 24rpx; }
.bottom-safe { height: calc(24rpx + env(safe-area-inset-bottom)); }
