/* 全局样式：中国邮政绿为主色，单列卡片布局，按钮和输入框至少 88rpx 高，方便现场单手操作。 */
page {
  --green: #006b45;
  --green-dark: #00553a;
  --green-soft: #e6f2ec;
  --ink: #1b2a22;
  --muted: #66756d;
  --line: #dde6e1;
  --bg: #f2f5f3;
  --card: #ffffff;
  --danger: #b3261e;
  --danger-soft: #fdecea;
  --warn-soft: #fff6e0;
  background: var(--bg);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page { padding: 24rpx 24rpx 0; }

.hero { padding: 16rpx 8rpx 28rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-sub { margin-top: 6rpx; color: var(--muted); font-size: 26rpx; }

.card { background: var(--card); border-radius: 24rpx; padding: 28rpx 28rpx 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 10rpx rgba(16, 52, 34, 0.05); }
.card-empty { color: var(--muted); text-align: center; font-size: 26rpx; padding: 40rpx 28rpx; }
.card-head { display: flex; align-items: center; margin-bottom: 20rpx; }
.card-title { font-size: 32rpx; font-weight: 600; }
.card-tip { margin-left: auto; color: var(--muted); font-size: 24rpx; }
.step { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%; background: var(--green); color: #fff; font-size: 24rpx; font-weight: 600; margin-right: 14rpx; flex-shrink: 0; }

.row { display: flex; gap: 20rpx; align-items: flex-start; }
.half { flex: 1; min-width: 0; }
.field { margin-top: 12rpx; }
.label { display: block; color: var(--muted); font-size: 26rpx; margin-bottom: 8rpx; }
.input, .textarea { box-sizing: border-box; width: 100%; background: #f7f9f8; border: 2rpx solid var(--line); border-radius: 16rpx; padding: 0 24rpx; font-size: 32rpx; color: var(--ink); }
.input { height: 88rpx; line-height: 88rpx; }
.textarea { min-height: 180rpx; padding: 20rpx 24rpx; line-height: 1.6; }
.readonly { background: #eef2f0; color: #3d4a43; }
.ph { color: #9aa79f; }
.counter { display: block; text-align: right; color: var(--muted); font-size: 22rpx; margin-top: 6rpx; }

.select { display: flex; align-items: center; min-height: 88rpx; border-bottom: 2rpx solid var(--line); }
.select .label { margin: 0; width: 180rpx; flex-shrink: 0; }
.select-value { flex: 1; font-size: 32rpx; }
.chevron { color: var(--muted); margin-left: 12rpx; font-size: 32rpx; }

.segmented { display: flex; background: #eef2f0; border-radius: 16rpx; padding: 6rpx; }
.segment { flex: 1; text-align: center; height: 76rpx; line-height: 76rpx; border-radius: 12rpx; color: var(--muted); font-size: 30rpx; }
.segment-on { background: #fff; color: var(--green); font-weight: 600; box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08); }

button::after { border: none; }
.btn { margin: 20rpx 0 0; height: 88rpx; line-height: 88rpx; border-radius: 16rpx; font-size: 30rpx; background: #fff; color: var(--green); border: 2rpx solid var(--green); padding: 0 24rpx; }
.btn-primary { background: var(--green); color: #fff; border-color: var(--green); }
.btn-block { width: 100%; margin: 0; }
.btn[disabled] { opacity: 0.45; }
.btn-primary[disabled] { background: var(--green) !important; color: #fff !important; }
.btn-small { height: 64rpx; line-height: 64rpx; font-size: 26rpx; margin-top: 12rpx; width: auto; display: inline-block; }

.link { color: var(--green); font-size: 26rpx; margin-left: auto; padding: 8rpx 0 8rpx 16rpx; }
.center { text-align: center; display: block; margin: 16rpx 0 0; }
.note { margin-top: 20rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: var(--green-soft); color: var(--green-dark); font-size: 26rpx; }
.note-muted { background: #f3f5f4; color: var(--muted); }
.hint { color: var(--muted); font-size: 24rpx; margin-top: 10rpx; }
.alert { border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 20rpx; font-size: 26rpx; }
.alert-error { background: var(--danger-soft); color: var(--danger); }
.alert-warn { background: var(--warn-soft); color: #7a5200; }

.question { margin-top: 24rpx; padding: 24rpx; border: 2rpx solid #f0c66a; background: #fffaf0; border-radius: 16rpx; }
.question-text { font-weight: 600; font-size: 30rpx; }

.rules { margin-top: 24rpx; border-top: 2rpx solid var(--line); }
.rules-head { display: flex; align-items: center; justify-content: space-between; min-height: 80rpx; color: var(--green); font-size: 28rpx; }
.rule { padding: 16rpx 0 20rpx; border-bottom: 2rpx dashed var(--line); }
.rule-clause { font-weight: 600; font-size: 28rpx; }
.rule-text { color: #3d4a43; font-size: 26rpx; margin-top: 6rpx; }
.tag { display: inline-block; margin-left: 12rpx; padding: 0 12rpx; border-radius: 8rpx; background: var(--green-soft); color: var(--green); font-size: 22rpx; font-weight: 400; }
.option { margin-top: 14rpx; padding: 16rpx 20rpx; background: #f7f9f8; border-radius: 12rpx; }
.option-label { font-size: 26rpx; }

.money { margin-top: 16rpx; padding: 16rpx 20rpx; background: var(--green-soft); border-radius: 14rpx; color: var(--green-dark); font-weight: 600; }
.confirm { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 24rpx; font-size: 28rpx; }
.checkbox { width: 40rpx; height: 40rpx; border: 3rpx solid var(--green); border-radius: 8rpx; text-align: center; line-height: 36rpx; color: #fff; font-size: 26rpx; flex-shrink: 0; margin-top: 4rpx; }
.checkbox-on { background: var(--green); }

.bottom-space { height: calc(220rpx + env(safe-area-inset-bottom)); }
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; background: rgba(255, 255, 255, 0.97); padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 16rpx rgba(16, 52, 34, 0.08); z-index: 10; }
.action-hint { color: var(--muted); font-size: 24rpx; text-align: center; margin-bottom: 10rpx; }

.empty { text-align: center; color: var(--muted); padding: 120rpx 0; font-size: 28rpx; }
