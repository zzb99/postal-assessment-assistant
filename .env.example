# 生产环境必须使用 PostgreSQL，例如：postgresql+psycopg://user:password@db:5432/assessment
DATABASE_URL=sqlite:///./assessment.db
# 至少 32 字节随机字符串，绝不提交真实值。
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# 前端部署地址，多个地址以英文逗号分隔。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 首次初始化管理员时临时设置；创建成功后从服务器环境中移除。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
# 正式部署仅写在服务器私有环境文件中，禁止使用 VITE_ 前缀。
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
DOCUMENT_ROOT=/data/documents
DOCUMENT_TEMPLATE_VERSION=20261013-2
LIBREOFFICE_BINARY=soffice
LIBREOFFICE_TIMEOUT_SECONDS=60
REQUIRE_TRUSTED_DEVICE=true
REQUIRE_POLICY_APPROVAL=true
AI_MAX_TOKENS=900
AI_CACHE_TTL_SECONDS=900
AI_CACHE_CAPACITY=256
AI_ERROR_CACHE_SECONDS=20
AI_PRICE_MODEL=deepseek-flash
AI_PEAK_HIT_CNY_PER_M=0.04
AI_PEAK_MISS_CNY_PER_M=2
AI_PEAK_OUTPUT_CNY_PER_M=8
AI_OFFPEAK_HIT_CNY_PER_M=0.02
AI_OFFPEAK_MISS_CNY_PER_M=1
AI_OFFPEAK_OUTPUT_CNY_PER_M=4
# 北京时间节假日，逗号分隔，例如 2026-10-01；仅用于估算，以服务商实际账单为准。
AI_PRICE_HOLIDAYS=
