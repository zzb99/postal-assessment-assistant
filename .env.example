# 生产环境必须使用 PostgreSQL，例如：postgresql+psycopg://user:password@db:5432/assessment
DATABASE_URL=sqlite:///./assessment.db
# 至少 32 字节随机字符串，绝不提交真实值。
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# 前端部署地址，多个地址以英文逗号分隔。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 首次初始化管理员时临时设置；创建成功后从服务器环境中移除。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
